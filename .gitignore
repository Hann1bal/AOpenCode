# Build outputs
.gradle/
build/
app/build/
local.properties
*.iml
.idea/
.DS_Store

# Backend assets are fetched by scripts/prepare-assets.sh in CI — do NOT commit them
app/src/main/assets/runtime/
*.tgz

# Keystore material
*.keystore
*.jks
*.keystore.b64

# The opencode fork is a separate git repo (pushed to its own remote); do not
# track it inside the app repo.
opencode-fork/

__pycache__/
*.pyc

# Locally built APKs, copied out of WSL for manual install. Never committed:
# an 83 MB binary per version stays in git history forever and every clone
# carries all of them. Published builds live on the GitHub Release instead.
dist/
*.apk

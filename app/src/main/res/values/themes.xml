<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.OpenCode" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/opencode_primary</item>
        <item name="colorOnPrimary">@color/opencode_on_primary</item>
        <item name="android:statusBarColor">?android:attr/colorBackground</item>
        <item name="android:navigationBarColor">?android:attr/colorBackground</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
    </style>

    <!-- Setup flow: warm amber accent, so configuring the endpoint does not look
         like the daily-driver screen. Applied to OnboardingActivity only. -->
    <style name="Theme.OpenCode.Onboarding" parent="Theme.OpenCode">
        <item name="colorPrimary">@color/setup_accent</item>
        <item name="colorOnPrimary">@color/setup_on_accent</item>
        <item name="colorSecondary">@color/setup_accent</item>
        <item name="colorOnSecondary">@color/setup_on_accent</item>
        <item name="colorSurfaceContainerHigh">@color/setup_accent_soft</item>
    </style>
</resources>

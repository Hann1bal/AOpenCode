<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?android:attr/colorBackground"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/peers_title"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/peers_subtitle"
        android:textSize="13sp" />

    <!-- What the backend is doing right now, so switching is an informed choice. -->
    <TextView
        android:id="@+id/modeStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_mode_chip"
        android:padding="12dp"
        android:text="@string/mode_local"
        android:textColor="#FFFFFFFF"
        android:textSize="13sp" />

    <!-- First-class exit from mirroring. Without this, going back to the local
         agent looked like it required deleting the pairing. -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/workLocallyButton"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/work_locally"
        android:visibility="gone" />

    <!-- Huawei/EMUI/HarmonyOS freeze background processes; a foreground service
         alone does not survive it. Shown only while we are still restricted. -->
    <LinearLayout
        android:id="@+id/batteryWarning"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_mode_chip"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/battery_title"
            android:textColor="#FFFFC9A0"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/battery_body"
            android:textColor="#FFFFFFFF"
            android:textSize="13sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/batteryButton"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/battery_open" />
    </LinearLayout>

    <ListView
        android:id="@+id/peerList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="12dp" />

    <TextView
        android:id="@+id/emptyView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="@string/peers_empty"
        android:textSize="14sp"
        android:visibility="gone" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/scanButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/peers_scan_qr" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/pasteButton"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/peers_paste_link" />

    <!-- Which engine the UI runs on. Decides which JS APIs exist, so it is the
         first thing to look at when the web layer throws a missing-method error. -->
    <TextView
        android:id="@+id/engineInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:textIsSelectable="true"
        android:textSize="11sp"
        android:alpha="0.55" />
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<!--
  Cleartext is permitted globally, and that is deliberate.

  Every host this app contacts is supplied by the user at runtime:
    - the bundled backend on 127.0.0.1
    - a self-hosted inference endpoint (Base URL on the setup screen)
    - a paired upstream over LAN / Tailscale (the pairing link host)

  Android's domain-config matches literal hostnames only. It has no CIDR or
  subnet support, so the previous per-range blocks (which used a `subnet`
  attribute that does not exist and was silently ignored) never matched
  anything, and plain HTTP to e.g. 100.87.88.47 failed with
  "Cleartext HTTP traffic not permitted". Enumerating exact IPs is not
  viable when the server changes per user.

  This does not weaken the app's actual threat model: there is no third-party
  traffic, HTTPS is still used whenever the endpoint provides it, and the
  system trust store remains the only anchor.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
